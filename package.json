{
  "name": "deckwise-demo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:no-fast-refresh": "next dev --webpack --no-server-fast-refresh",
    "dev:turbo-no-fast-refresh": "next dev --no-server-fast-refresh",
    "build": "next build",
    "prod:build": "cross-env NODE_ENV=production npm run build",
    "prod:start": "cross-env NODE_ENV=production npm run start",
    "prod": "npm run prod:build && npm run prod:start",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node ./scripts/typecheck/runTypecheck.mjs",
    "test": "npm run test:layout && npm run test:unit",
    "test:ci": "npm run lint && npm run typecheck && npm run test",
    "test:layout": "node ./scripts/tests/validate-test-layout.mjs",
    "test:core": "vitest run --config vitest.config.ts tests/unit/features/workbench tests/unit/app/workbench tests/unit/app/login tests/unit/app/gate tests/unit/app/apiProxyRoute.spec.ts tests/unit/lib/auth tests/unit/lib/stream tests/unit/lib/markdown tests/unit/components/features/markdown tests/unit/components/features/settings tests/unit/lib/api/fetcher.spec.ts tests/unit/lib/api/fetcherWithAuth.spec.ts tests/unit/lib/api/modelProviders.spec.ts tests/unit/lib/api/sessionStream.spec.ts tests/unit/lib/server/apiProxyRequestPolicy.spec.ts --reporter=dot",
    "test:unit": "vitest run --config vitest.config.ts --reporter=dot",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:ci": "playwright test --config playwright.config.ts --reporter=line,html --pass-with-no-tests",
    "api:clean": "node scripts/orval/cleanGenerated.mjs",
    "api:gen": "npm run api:clean && orval && node scripts/orval/generateTypesIndex.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.9.0",
    "next": "^16.4.3",
    "next-intl": "4.13.4",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.27.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.0.2",
    "orval": "^8.8.1",
    "tailwindcss": "^4.2.3",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
