# The Agent receives per-user BYOK credentials from Backend over local gRPC.
# Provider API keys are optional fallbacks for requests without a BYOK provider.

GRPC_PORT=41051
BACKEND_TOOL_HOST=127.0.0.1
BACKEND_TOOL_GRPC_PORT=40052
AGENT_MODE=agent_rag

# Optional local fallback keys. Leave empty when all requests use Backend BYOK.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
