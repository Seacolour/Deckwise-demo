# Copy to .env.local for local development. NEXT_PUBLIC_* values are bundled into the browser.

# Next.js forwards authenticated API and SSE requests to the Java Backend.
API_PROXY_TARGET=http://localhost:8104
# Optional separate upload target; empty means API_PROXY_TARGET.
UPLOAD_PROXY_TARGET=
# Optional comma-separated hosts for the legacy /api/pdf and /api/proxy URL forwarders.
# Leave empty to disable forwarding to arbitrary external hosts.
FILE_PROXY_ALLOWED_HOSTS=
# Optional Host override when a reverse proxy requires one.
API_HOST=

NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEBUG=false
# Use a different non-secret signature per Backend environment. Production builds cannot use "local".
NEXT_PUBLIC_BACKEND_SIGNATURE=demo-local

# Optional: point Orval at another running Backend when regenerating API clients.
# ORVAL_OPENAPI_URL=http://localhost:8104/api/v3/api-docs
