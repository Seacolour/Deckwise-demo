# Copy to .env for an IDE run configuration or export these as process environment variables.
# Do not commit a populated .env to the public repository.

# PostgreSQL database used by Spring, Flyway, and jOOQ code generation.
DB_PASSWORD=

# Generate a private JWT secret and a stable base64-encoded 32-byte credential key.
APP_JWT_SECRET=
APP_MODEL_CREDENTIAL_ENCRYPTION_KEY=

# Resend email-code login. Use an address verified for your Resend account.
APP_RESEND_API_KEY=
APP_RESEND_FROM=

# Cloudflare R2 object storage. Public and private scopes can use the same demo bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BUCKET=dev
R2_PRIVATE_BUCKET=dev

# For a non-local Web origin, configure the allowed origin in the Backend environment.
# APP_SECURITY_WEB_SESSION_COOKIE_ALLOWED_ORIGINS=https://demo.example
# APP_WEB_SESSION_COOKIE_SECURE=true
